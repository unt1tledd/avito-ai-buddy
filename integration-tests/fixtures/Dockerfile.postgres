FROM postgres:16-bookworm
COPY integration-tests/fixtures/init.sql /docker-entrypoint-initdb.d/01-init.sql
COPY auth/migrations/000001_create_users.sql /tmp/auth.sql
# Use the production migration, excluding its rollback section.
RUN printf '\\connect auth_db\n' > /docker-entrypoint-initdb.d/02-auth.sql \
    && awk '/^-- \+goose Down/ {exit} {print}' /tmp/auth.sql >> /docker-entrypoint-initdb.d/02-auth.sql
