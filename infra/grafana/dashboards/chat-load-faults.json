{
  "uid": "chat-load-faults",
  "title": "Нагрузка · Сбои провайдера",
  "description": "Сбои провайдера намеренные. Прохождение проверок fallback определяет k6.",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "ai-buddy",
    "load-test"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Завершения RPC за минуту",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (method, code) (count_over_time({service=\"chat\"} |= \"RPC completed\" | json rid=\"request_id\" | __error__=\"\" | rid!=\"\" | rid=~\"^${run_prefix:regex}[0-9a-f]*$\" | json method=\"rpc\", code=\"code\", ms=\"duration_ms\" | __error__=\"\" | method=~\".*/(GetHistory|SendMessage)\" | drop rid, ms [1m]))",
          "legendFormat": "{{method}} · {{code}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "p95 успешных RPC",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service=\"chat\"} |= \"RPC completed\" | json rid=\"request_id\" | __error__=\"\" | rid!=\"\" | rid=~\"^${run_prefix:regex}[0-9a-f]*$\" | json method=\"rpc\", code=\"code\", ms=\"duration_ms\" | __error__=\"\" | method=~\".*/(GetHistory|SendMessage)\" | code=\"OK\" | drop rid | unwrap ms | __error__=\"\" [2m]) by (method)",
          "legendFormat": "{{method}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {}
    },
