{
  "name": "avito-ai-buddy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "Preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --src src --include 'src/**/*.{js,jsx,ts,tsx}' --extension=.js --extension=.jsx --extension=.ts --extension=.tsx --exclude-after-remap --reporter=text-summary --reporter=lcov npm test",
    "lint": "eslint src tests eslint.config.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.1"
  }
}
