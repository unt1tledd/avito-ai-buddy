          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=~\"chat|ai|task|user|onboarding|auth\"} | json rid=\"request_id\" | __error__=\"\" | rid!=\"\" | rid=~\"^${run_prefix:regex}[0-9a-f]*$\"",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
